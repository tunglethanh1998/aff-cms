# Postgres (docker compose)
POSTGRES_USER=aff_cms
POSTGRES_PASSWORD=aff_cms
POSTGRES_DB=aff_cms
POSTGRES_PORT=55432

# API
DATABASE_URL=postgresql://aff_cms:aff_cms@localhost:55432/aff_cms?schema=public
API_PORT=3001
CORS_ORIGIN=http://localhost:3000
WEB_APP_URL=http://localhost:3000

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
ADMIN_EMAIL=admin@affcms.local
ADMIN_PASSWORD=admin123456

# TikTok Developer App
# Products: Login Kit, TikTok API (Display), Content Posting API (Upload to TikTok)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Web Login Kit requires https:// (no localhost). Use cloudflared/ngrok tunnel.
TIKTOK_REDIRECT_URI=https://exposure-specials-father-differently.trycloudflare.com/tiktok/oauth/callback

# AES-256-GCM key: 32 bytes as 64 hex characters
TOKEN_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# S3 assets (images) — also accepts Yosonavi names:
# AWS_S3_BUCKET_NAME, AWS_S3_BUCKET_REGION, AWS_S3_ACCESS_KEY_ID,
# AWS_S3_SECRET_ACCESS_KEY, AWS_CLOUDFRONT_PREFIX
AWS_REGION=ap-southeast-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_KEY_PREFIX=assets
# Optional CDN/public base, e.g. https://dcj8h3kzzo61z.cloudfront.net
S3_PUBLIC_BASE_URL=
# Optional for R2/MinIO
# S3_ENDPOINT=
# S3_FORCE_PATH_STYLE=true

# Web
NEXT_PUBLIC_API_URL=http://localhost:3001
