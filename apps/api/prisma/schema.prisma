generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
}

enum DraftJobStatus {
  PENDING
  UPLOADING
  SENT_TO_INBOX
  FAILED
}

enum DailyProductStatus {
  PENDING
  SYNCING
  READY
  FAILED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(ADMIN)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("users")
}

/// Short-lived TikTok OAuth PKCE state (shared across ECS tasks).
model OAuthState {
  state        String   @id
  codeVerifier String   @map("code_verifier")
  createdAt    DateTime @default(now()) @map("created_at")
  expiresAt    DateTime @map("expires_at")

  @@index([expiresAt])
  @@map("oauth_states")
}

model TikTokAccount {
  id              String    @id @default(cuid())
  openId          String    @unique @map("open_id")
  username        String?
  displayName     String?   @map("display_name")
  avatarUrl       String?   @map("avatar_url")
  followerCount   BigInt    @default(0) @map("follower_count")
  videoCount      BigInt    @default(0) @map("video_count")
  likesCount      BigInt    @default(0) @map("likes_count")
  viewCount       BigInt    @default(0) @map("view_count")
  commentCount    BigInt    @default(0) @map("comment_count")
  accessTokenEnc  String    @map("access_token_enc")
  refreshTokenEnc String    @map("refresh_token_enc")
  tokenExpiresAt  DateTime? @map("token_expires_at")
  lastSyncedAt    DateTime? @map("last_synced_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  drafts        TikTokDraftJob[]
  videos        TikTokVideo[]
  assetFolders  AssetFolder[]
  assets        Asset[]
  dailyProducts DailyProduct[]

  @@map("tiktok_accounts")
}

model TikTokVideo {
  id           String   @id @default(cuid())
  accountId    String   @map("account_id")
  tiktokVideoId String  @map("tiktok_video_id")
  title        String?
  description  String?
  coverUrl     String?  @map("cover_url")
  shareUrl     String?  @map("share_url")
  embedLink    String?  @map("embed_link")
  durationSec  Int?     @map("duration_sec")
  viewCount    BigInt   @default(0) @map("view_count")
  likeCount    BigInt   @default(0) @map("like_count")
  commentCount BigInt   @default(0) @map("comment_count")
  shareCount   BigInt   @default(0) @map("share_count")
  publishedAt  DateTime? @map("published_at")
  syncedAt     DateTime @default(now()) @map("synced_at")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@unique([accountId, tiktokVideoId])
  @@index([accountId, publishedAt])
  @@map("tiktok_videos")
}

model TikTokDraftJob {
  id              String         @id @default(cuid())
  accountId       String         @map("account_id")
  caption         String?
  localFileName   String         @map("local_file_name")
  tiktokPublishId String?        @map("tiktok_publish_id")
  status          DraftJobStatus @default(PENDING)
  errorMessage    String?        @map("error_message")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  account TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  @@index([accountId])
  @@map("tiktok_draft_jobs")
}

model AssetFolder {
  id                String   @id @default(cuid())
  accountId         String?  @map("account_id")
  name              String
  parentId          String?  @map("parent_id")
  path              String   @unique
  portraitAssetId   String?  @map("portrait_asset_id")
  backgroundAssetId String?  @map("background_asset_id")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  account         TikTokAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  parent          AssetFolder?   @relation("AssetFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children        AssetFolder[]  @relation("AssetFolderTree")
  assets          Asset[]
  dailyProducts   DailyProduct[]
  portraitAsset   Asset?         @relation("FolderPortrait", fields: [portraitAssetId], references: [id], onDelete: SetNull)
  backgroundAsset Asset?         @relation("FolderBackground", fields: [backgroundAssetId], references: [id], onDelete: SetNull)

  @@index([parentId])
  @@index([accountId, parentId])
  @@index([portraitAssetId])
  @@index([backgroundAssetId])
  @@map("asset_folders")
}

model DailyProduct {
  id           String             @id @default(cuid())
  accountId    String             @map("account_id")
  date         DateTime           @db.Date
  slot         Int
  productUrl   String             @map("product_url")
  title        String?
  folderId     String             @map("folder_id")
  status       DailyProductStatus @default(PENDING)
  errorMessage String?            @map("error_message")
  imageCount   Int                @default(0) @map("image_count")
  createdAt    DateTime           @default(now()) @map("created_at")
  updatedAt    DateTime           @updatedAt @map("updated_at")

  account TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder  AssetFolder   @relation(fields: [folderId], references: [id], onDelete: Restrict)

  @@unique([accountId, date, slot])
  @@index([accountId, date])
  @@map("daily_products")
}

model ProductPrompt {
  id        String   @id @default(cuid())
  name      String
  category  String
  content   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([category, name])
  @@index([category, updatedAt])
  @@map("product_prompts")
}

model Asset {
  id           String   @id @default(cuid())
  accountId    String?  @map("account_id")
  folderId     String?  @map("folder_id")
  filename     String
  originalName String   @map("original_name")
  mimeType     String   @map("mime_type")
  sizeBytes    BigInt   @map("size_bytes")
  width        Int?
  height       Int?
  s3Key        String   @unique @map("s3_key")
  etag         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  account TikTokAccount? @relation(fields: [accountId], references: [id], onDelete: Cascade)
  folder  AssetFolder?   @relation(fields: [folderId], references: [id], onDelete: SetNull)
  foldersUsingAsPortrait   AssetFolder[] @relation("FolderPortrait")
  foldersUsingAsBackground AssetFolder[] @relation("FolderBackground")

  @@index([folderId, createdAt])
  @@index([accountId, createdAt])
  @@map("assets")
}
